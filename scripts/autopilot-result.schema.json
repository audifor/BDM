{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "BLOCKED"
      ]
    },
    "milestone": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "tests_total": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reason": {
      "type": "string"
    },
    "human_decision_required": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "milestone",
    "summary",
    "commit",
    "tests_total",
    "reason",
    "human_decision_required"
  ],
  "additionalProperties": false
}