{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basketball Dynasty Manager",
  "version": "0.1.0",
  "identifier": "com.bdm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Basketball Dynasty Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
